<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/m3_widget_card_bg"
    android:orientation="vertical">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_launcher"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="1-TAP BOOST"
            android:textColor="@color/m3_widget_primary"
            android:textStyle="bold"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/m3_status_pill"
            android:text="Ready"
            android:textColor="@color/m3_widget_on_tertiary_container"
            android:textStyle="bold"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Metrics Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <!-- Storage Tile -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/m3_widget_tile_bg"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STORAGE"
                android:textColor="@color/m3_widget_text_muted"
                android:textStyle="bold"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_storage_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-- GB Free"
                android:textColor="@color/m3_widget_text_primary"
                android:textStyle="bold"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/widget_onetap_progress_storage"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="35"
                android:progressDrawable="@drawable/m3_progress_bar_horizontal" />
        </LinearLayout>

        <!-- RAM Tile -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/m3_widget_tile_bg"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RAM USAGE"
                android:textColor="@color/m3_widget_text_muted"
                android:textStyle="bold"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_ram_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--% Used"
                android:textColor="@color/m3_widget_text_primary"
                android:textStyle="bold"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/widget_onetap_progress_ram"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="60"
                android:progressDrawable="@drawable/m3_progress_bar_horizontal" />
        </LinearLayout>
    </LinearLayout>

    <!-- One-Tap Action Button -->
    <Button
        android:id="@+id/btn_widget_clean"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/m3_btn_primary"
        android:text="⚡ BOOST NOW"
        android:textColor="@color/m3_widget_on_primary"
        android:textStyle="bold"
        android:textSize="13sp" />

</LinearLayout>
